---
import ComponentsDocument from '../components/component-document/ComponentsDocument'
import '../styles/global.css'
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="PzHown UI 本地组件、组合关系、变体与状态的完整调试文档" />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='18' fill='%2312171f'/%3E%3Ctext x='32' y='41' text-anchor='middle' font-size='22' font-family='sans-serif' fill='white'%3EPH%3C/text%3E%3C/svg%3E" />
    <title>PzHown UI · 本地组件文档</title>
  </head>
  <body>
    <ComponentsDocument client:load />
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    background: #f5f5f3;
    color: #121316;
    font-family:
      Inter, ui-sans-serif, -apple-system, BlinkMacSystemFont, "SF Pro Display", "Segoe UI", sans-serif;
    text-rendering: optimizeLegibility;
    scroll-behavior: smooth;
  }

  :global(body) {
    margin: 0;
    min-width: 320px;
    background: #f5f5f3;
  }

  :global(button),
  :global(input),
  :global(textarea),
  :global(select) {
    font: inherit;
  }
</style>
