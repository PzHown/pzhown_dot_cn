---
import { createProgressiveBlurModel, type ProgressiveBlurOptions } from './core'

type Props = ProgressiveBlurOptions & {
  className?: string
  /** @deprecated Use className for parity with React/Next. */
  class?: string
  style?: string
  id?: string
}

const {
  mode = 'linear',
  side = 'top',
  strength = 64,
  steps = 8,
  falloff = 100,
  tint = 'transparent',
  className,
  class: legacyClassName,
  style = '',
  ...attrs
} = Astro.props

const model = createProgressiveBlurModel({ mode, side, strength, steps, falloff, tint })
const rootStyle = `--pzhown-pb-tint:${model.tintBackground};${style}`
---

<div
  {...attrs}
  aria-hidden="true"
  class:list={['pzhown-progressive-blur', className, legacyClassName]}
  data-progressive-blur={mode}
  data-progressive-blur-side={side}
  style={rootStyle}
>
  <div class="pzhown-progressive-blur__surface">
    {
      model.layers.map((layer, index) => {
        const blur = `${layer.blur.toFixed(3)}px`
        return (
          <div
            class="pzhown-progressive-blur__layer"
            style={`z-index:${index + 1};-webkit-backdrop-filter:blur(${blur});backdrop-filter:blur(${blur});-webkit-mask:${layer.mask};mask:${layer.mask};`}
          />
        )
      })
    }
  </div>
</div>
